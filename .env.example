# Copie para .env e ajuste. O modo Node lê este arquivo via ./office.sh.
HABBLAUD_WORLD=0
HABBLAUD_CODEX=0
HABBLAUD_PTY=1
HABBLAUD_CLAUDE_DIRS=$HOME/.claude,$HOME/.claude-trabalho
HABBLAUD_ACCOUNTS=[{"id":".claude","name":"Pessoal","short":"P","color":"#4aa8e8"},{"id":".claude-trabalho","name":"Trabalho","short":"T","color":"#5cc97b"}]
HABBLAUD_LANG=pt-BR
# Caminho real do claude (evite atalhos temporários do cmux): command -v claude
HABBLAUD_CLAUDE_BIN=$HOME/.local/bin/claude
